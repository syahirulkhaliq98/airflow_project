[Unit]
Description=Airflow Webserver
After=network-online.target mongod.service airflow-scheduler.service
Wants=network-online.target

[Service]
User=khaliq
Group=khaliq
Environment=AIRFLOW_HOME=/home/khaliq/airflow_project/airflow
Environment=VIRTUAL_ENV=/home/khaliq/airflow_project/venv
Environment=PATH=/home/khaliq/airflow_project/venv/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/khaliq/airflow_project
ExecStart=/home/khaliq/airflow_project/venv/bin/airflow webserver --port 8080
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
